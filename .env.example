# Copy to .env and fill in real values for local/dev use.
# Never commit the real .env file (already covered by .gitignore).

# --- Shared ---
JWT_SECRET=dev-only-change-me

# --- Core service (services/core) ---
DATABASE_URL=postgresql://healthbridge:healthbridge@localhost:5432/healthbridge
REDIS_URL=redis://localhost:6379/0
CORE_PORT=8000

# --- AI service (services/ai) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi4-mini
AI_PORT=8100

# --- Web app / gateway (apps/web) ---
CORE_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8100
WEB_PORT=3000
