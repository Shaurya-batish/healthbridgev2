# Copy to .env and fill in real values for local/dev use.
# Never commit the real .env file (already covered by .gitignore).

# --- Shared ---
JWT_SECRET=dev-only-change-me

# --- Core service (services/core) ---
DATABASE_URL=postgresql://healthbridge:healthbridge@localhost:5432/healthbridge
REDIS_URL=redis://localhost:6379/0
CORE_PORT=8000

# --- ABDM Gateway (HIP-side, real integration -- see
# docs/REAL-INTEGRATION-AUDIT.md). Requires NHA HIP registration and
# certification; left unset here means the app reports abdm_not_configured
# rather than fabricating a response.
ABDM_GATEWAY_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
ABDM_CM_ID=sbx

# --- PM-JAY / state scheme verification -- requires NHA hospital
# empanelment, see the audit doc.
NHA_BENEFICIARY_BASE_URL=
NHA_OPERATOR_USERNAME=
NHA_OPERATOR_PASSWORD=

# --- Teleconsult store-and-forward media (self-hosted, no external dep) ---
TELECONSULT_MEDIA_DIR=./data/teleconsult-media

# --- AI service (services/ai) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi4-mini
AI_PORT=8100

# --- Web app / gateway (apps/web) ---
CORE_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8100
WEB_PORT=3000
