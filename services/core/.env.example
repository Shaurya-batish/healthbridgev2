DATABASE_URL=postgresql://healthbridge:healthbridge@localhost:5432/healthbridge
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me
PORT=8000

# --- ABDM Gateway (HIP-side) -- see docs/REAL-INTEGRATION-AUDIT.md ---
# Leave unset until real NHA HIP registration/certification is complete.
# Never fabricated: the app returns 501 abdm_not_configured until these
# are set to real, NHA-issued values.
ABDM_GATEWAY_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
ABDM_CM_ID=sbx

# --- PM-JAY / state scheme verification (NHA Beneficiary Identification
# System) -- requires NHA hospital empanelment, also see the audit doc ---
NHA_BENEFICIARY_BASE_URL=
NHA_OPERATOR_USERNAME=
NHA_OPERATOR_PASSWORD=

# --- Teleconsult store-and-forward media (self-hosted, no external dep) ---
TELECONSULT_MEDIA_DIR=./data/teleconsult-media
