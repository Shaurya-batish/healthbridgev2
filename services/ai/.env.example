# Ollama running Phi-4-mini (install Ollama separately, then: ollama pull phi4-mini)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi4-mini

PORT=8100

# Optional: override the resolved path to the shared rule table. Defaults to
# <repo-root>/rules/imnci-rules.v1.json (resolved relative to this service).
# RULES_PATH=/absolute/path/to/imnci-rules.v1.json

OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_HEALTH_TIMEOUT_SECONDS=2
